# Copy to .env (docker compose reads it automatically). Never commit the real .env.
# The Spring app reads these from real environment variables, so export them
# (or set them in your IDE run configuration) when you need values other than the dev defaults.

SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
DB_NAME=career
DB_USERNAME=career
DB_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/career
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT: at least 32 characters. Required in prod, dev has an insecure default.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# First admin account, created at startup if it does not exist (dev defaults: admin@career.local / Admin12345)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Comma separated list of frontend origins allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Port of the app container (docker compose --profile app)
APP_PORT=8080

# LLM. Leave AI_ENABLED=false to use the built-in fake model (no key needed).
# For a real model: AI_ENABLED=true, AI_PROVIDER=openai and an API key.
AI_ENABLED=false
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
